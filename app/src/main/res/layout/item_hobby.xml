<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:background="@drawable/duo_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Circular Icon Box -->
    <FrameLayout
        android:id="@+id/iconBox"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/icon_circle_bg">

        <TextView
            android:id="@+id/imgIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🎵"
            android:textSize="24sp" />
    </FrameLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="14dp"
        android:orientation="vertical">

        <!-- Name + Level Badge Row -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="Piano"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Master crown (shown when 10,000 hrs reached) -->
            <TextView
                android:id="@+id/txtMasterBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/txtName"
                android:layout_marginStart="6dp"
                android:text="👑"
                android:textSize="16sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtLevelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/level_badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Level 1"
                android:textColor="@color/duo_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Hours text -->
        <TextView
            android:id="@+id/txtHours"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 10,000 hrs"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Progress Bar track -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="10dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/progress_track_bg">

            <View
                android:id="@+id/progressFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/progress_fill_bg" />
        </FrameLayout>

    </LinearLayout>

</LinearLayout>
